REDIS_DB=0

# Default: Send activation and password reset emails via SMTP.
# Configure valid SMTP credentials in your private .env file.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=live.smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_HOST_USER=api
EMAIL_HOST_PASSWORD=your_mailtrap_api_token
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=hello@demomailtrap.co

# Alternative for local testing without SMTP credentials:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Emails will then appear in: docker compose logs -f web


FRONTEND_ACTIVATION_URL=http://127.0.0.1:5500/pages/auth/activate.html
